        <object label="&lt;font style=&quot;font-size: 15px&quot;&gt;&lt;b&gt;PropDevelopment&lt;/b&gt;&lt;/font&gt;&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot; color=&quot;#f0f0f0&quot;&gt;Мобильное приложение и сервисы ЖКУ для собственников. Хранит права доступа и журнал событий&lt;/font&gt;&lt;/div&gt;" id="c5">
