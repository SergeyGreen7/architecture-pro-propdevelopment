        <object label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;Житель или гость&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot; color=&quot;#cccccc&quot;&gt;Звонит в домофон, проходит в подъезд, въезжает на парковку&lt;/font&gt;&lt;/div&gt;" id="c4">
