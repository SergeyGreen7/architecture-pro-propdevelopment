        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;strokeWidth=2;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="Публичные данные" vertex="1">
          <mxGeometry height="70" width="200" x="-410" y="302" as="geometry" />
        </mxCell>
        <mxCell id="n5" edge="1" parent="1" source="n3" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1f4e79;strokeWidth=2.5;" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=12;fillColor=#ffffff;strokeColor=#FFFFFF;strokeWidth=2;arcSize=6;" value="• Каталог объектов недвижимости: &lt;br&gt;-- описания ЖК&lt;br&gt;-- планировки&lt;br&gt;-- фото&lt;br&gt;-- цены&lt;br&gt;-- статусы (витрина продаж)&lt;br&gt;• Материалы онлайн-туров: &lt;br&gt;-- 3D-модели и фото объектов&lt;br&gt;• Публичная информация о компании, ЖК и ходе строительства&lt;br&gt;• Публичная оферта, общие условия бронирования и покупки" vertex="1">
          <mxGeometry height="320" width="360" x="-830" y="177" as="geometry" />
        </mxCell>
        <mxCell id="n7" edge="1" parent="1" source="n4" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=2;" target="n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=30;fillColor=#d5e8d4;strokeColor=#82b366;" value="Утечка&lt;br&gt;&lt;b&gt;незначительный&lt;/b&gt;" vertex="1">
          <mxGeometry height="46" width="250" x="-1140" y="154" as="geometry" />
        </mxCell>
        <mxCell id="n9" edge="1" parent="1" source="n6" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.5;" target="n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=12;fillColor=#f9f9f9;strokeColor=#b3b3b3;arcSize=8;" value="Данные изначально открыты и опубликованы на витрине продаж. Утечка не раскрывает ничего нового и не влечёт юридических последствий." vertex="1">
          <mxGeometry height="66" width="450" x="-1650" y="144" as="geometry" />
        </mxCell>
        <mxCell id="n11" edge="1" parent="1" source="n8" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#999999;strokeWidth=1;" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=30;fillColor=#d5e8d4;strokeColor=#82b366;" value="Потеря&lt;br&gt;&lt;b&gt;незначительный&lt;/b&gt;" vertex="1">
          <mxGeometry height="46" width="250" x="-1140" y="234" as="geometry" />
        </mxCell>
        <mxCell id="n13" edge="1" parent="1" source="n6" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.5;" target="n12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=12;fillColor=#f9f9f9;strokeColor=#b3b3b3;arcSize=8;" value="Каталог хранится в client-mart-estate-db с резервным копированием, медиаматериалы туров восстанавливаются из исходников. Возможен лишь кратковременный простой витрины." vertex="1">
          <mxGeometry height="66" width="450" x="-1650" y="224" as="geometry" />
        </mxCell>
        <mxCell id="n15" edge="1" parent="1" source="n12" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#999999;strokeWidth=1;" target="n14">
          <mxGeometry relative="1" as="geometry" />
