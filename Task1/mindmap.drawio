        </mxCell>
        <mxCell id="n53" edge="1" parent="1" source="n3" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1f4e79;strokeWidth=2.5;" target="n52">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n54" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=12;fillColor=#ffffff;strokeColor=#FFFFFF;strokeWidth=2;arcSize=6;" value="• ПДн клиентов: &lt;br&gt;-- ФИО&lt;br&gt;-- телефон&lt;br&gt;-- e-mail&lt;br&gt;-- расширенная форма&lt;br&gt;• ПДн собственников: &lt;br&gt;-- ФИО&lt;div&gt;-- адрес&lt;br&gt;-- лицевой счёт&lt;br&gt;-- контакты&lt;br&gt;• Бронирования и результаты осмотров&amp;nbsp;&lt;br&gt;• Начисления и история оплат ЖКУ&amp;nbsp;&lt;br&gt;• Бухгалтерский и финансовый учёт&lt;br&gt;• Сырые копии данных всех систем&lt;br&gt;• Договоры и данные партнёров: &lt;br&gt;-- УК&lt;br&gt;-- поставщики ресурсов ЖКХ&lt;br&gt;• Телеметрия и журнал событий «Умного дома»&lt;/div&gt;" vertex="1">
          <mxGeometry height="400" width="360" x="470" y="120" as="geometry" />
        </mxCell>
        <mxCell id="n55" edge="1" parent="1" source="n52" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=2;" target="n54">
