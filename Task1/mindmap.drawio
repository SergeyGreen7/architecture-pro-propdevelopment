        <mxCell id="n3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1f4e79;strokeColor=#0f2a44;fontColor=#ffffff;fontSize=20;fontStyle=1;strokeWidth=2;" value="Безопасность данных" vertex="1">
