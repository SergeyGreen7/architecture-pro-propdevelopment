        <mxCell id="n48" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=30;fillColor=#f8cecc;strokeColor=#b85450;" value="Обесценивание&lt;br&gt;&lt;b&gt;критический&lt;/b&gt;" vertex="1">
          <mxGeometry height="46" width="250" x="-1140" y="950" as="geometry" />
        </mxCell>
        <mxCell id="n49" edge="1" parent="1" source="n30" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.5;" target="n48">
