          <mxGeometry height="46" width="250" x="-1140" y="790" as="geometry" />
        </mxCell>
        <mxCell id="n41" edge="1" parent="1" source="n30" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.5;" target="n40">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n42" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=12;fillColor=#f9f9f9;strokeColor=#b3b3b3;arcSize=8;" value="В системах обработки данных нет ограничений доступа, поэтому отчёты BI и графики работ могут быть изменены. Искажённые отчёты ведут к ошибочным управленческим решениям." vertex="1">
          <mxGeometry height="66" width="450" x="-1650" y="780" as="geometry" />
        </mxCell>
        <mxCell id="n43" edge="1" parent="1" source="n40" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#999999;strokeWidth=1;" target="n42">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n44" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Некачественные данные&lt;br&gt;&lt;b&gt;значительный&lt;/b&gt;" vertex="1">
          <mxGeometry height="46" width="250" x="-1140" y="870" as="geometry" />
        </mxCell>
        <mxCell id="n45" edge="1" parent="1" source="n30" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.5;" target="n44">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=12;fillColor=#f9f9f9;strokeColor=#b3b3b3;arcSize=8;" value="Хранилище получает сырые данные по CDC из многих БД без согласования форматов и единого мастер-источника. Дубли и противоречия снижают достоверность отчётов BI." vertex="1">
          <mxGeometry height="66" width="450" x="-1650" y="860" as="geometry" />
        </mxCell>
        <mxCell id="n47" edge="1" parent="1" source="n44" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#999999;strokeWidth=1;" target="n46">
          <mxGeometry relative="1" as="geometry" />
