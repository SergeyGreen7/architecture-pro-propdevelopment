        <mxCell id="n16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Искажение&lt;br&gt;&lt;b&gt;значительный&lt;/b&gt;" vertex="1">
          <mxGeometry height="46" width="250" x="-1140" y="314" as="geometry" />
        </mxCell>
        <mxCell id="n17" edge="1" parent="1" source="n6" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.5;" target="n16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=12;fillColor=#f9f9f9;strokeColor=#b3b3b3;arcSize=8;" value="Клиенты принимают решения по ценам и характеристикам с витрины. Неверные данные (или дефейс витрины) ведут к претензиям, спорам по бронированиям и репутационному ущербу." vertex="1">
          <mxGeometry height="66" width="450" x="-1650" y="304" as="geometry" />
        </mxCell>
        <mxCell id="n19" edge="1" parent="1" source="n16" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#999999;strokeWidth=1;" target="n18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Некачественные данные&lt;br&gt;&lt;b&gt;значительный&lt;/b&gt;" vertex="1">
